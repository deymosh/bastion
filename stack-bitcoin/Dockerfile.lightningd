# Core Lightning with Bastion's plugins, built from pinned sources.
#
# Supply chain: both stages use the same digest-pinned base; every plugin is a
# git commit; every downloaded binary/toolchain is a pinned version, and the
# tarballs are sha256-verified against the checksum their publisher lists
# (go.dev's download index, the GitHub release asset digest). To bump one,
# change the version AND its checksum together.

# Use base lightningd image to build plugins
FROM elementsproject/lightningd:v26.06.8@sha256:56f1cebe829fbb3c7d5674be8cd1212c7e02527ab32403b695033a29bcd2abce AS builder

# Install compilation dependencies and plugins
RUN apt-get update && apt-get install -y \
    git \
    autoconf-archive \
    libtool \
    curl \
    wget \
    ca-certificates \
    pkg-config \
    protobuf-compiler \
    libssl-dev \
    libev-dev \
    libffi-dev \
    libsqlite3-dev \
    libcurl4-gnutls-dev \
    libunwind-dev \
    build-essential \
    dnsutils \
    python3-pip && \
    rm -rf /var/lib/apt/lists/*

## Define TrustedCoin plugin version (sha256 = the release asset's digest on GitHub)
ENV TRUSTEDCOIN_RELEASE="v0.8.7"
ENV TRUSTEDCOIN_SHA256="c8d7d4095a8e71d97e3ff7440e33ce61f9901ff2a3ed1582b83dcf75c901040c"

# Install TrustedCoin plugin
RUN echo "--- Installing TrustedCoin Plugin ---" && \
    curl -fsSL -o /tmp/trustedcoin.tar.gz https://github.com/nbd-wtf/trustedcoin/releases/download/$TRUSTEDCOIN_RELEASE/trustedcoin-$TRUSTEDCOIN_RELEASE-linux-amd64.tar.gz && \
    echo "$TRUSTEDCOIN_SHA256  /tmp/trustedcoin.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/trustedcoin.tar.gz -C /usr/local/bin/ && \
    rm /tmp/trustedcoin.tar.gz && \
    chmod +x /usr/local/bin/trustedcoin && \
    echo "--- TrustedCoin Plugin installed successfully ---"

## Define PeerSwap plugin version
## v7.0.1 (Bitcoin-only here; this release also rejects new Liquid swaps)
ENV PEERSWAP_COMMIT="0d398008c8902816a300505962e672e9a24807a9"
ENV GO_VERSION="1.23.4"
# sha256 of go$GO_VERSION.linux-amd64.tar.gz, from https://go.dev/dl/?mode=json&include=all
ENV GO_SHA256="6924efde5de86fe277676e929dc9917d466efa02fb934197bc2eba35d5680971"

# Install PeerSwap plugin
RUN git clone https://github.com/ElementsProject/peerswap.git /tmp/peerswap_build && \
    cd /tmp/peerswap_build && \
    git checkout $PEERSWAP_COMMIT

WORKDIR /tmp/peerswap_build
RUN echo "--- Installing PeerSwap Plugin ---" && \
    wget -q https://go.dev/dl/go$GO_VERSION.linux-amd64.tar.gz && \
    echo "$GO_SHA256  go$GO_VERSION.linux-amd64.tar.gz" | sha256sum -c - && \
    tar -C /usr/local -xzf go$GO_VERSION.linux-amd64.tar.gz && \
    export PATH=$PATH:/usr/local/go/bin && \
    make cln-release && \
    cp peerswap /usr/local/bin/peerswap && \
    chmod +x /usr/local/bin/peerswap && \
    cd /root && \
    rm -rf /tmp/peerswap_build && \
    echo "--- PeerSwap Plugin installed successfully ---"

## Define TEOS version
ENV TEOS_COMMIT="be344ecc5286dd9436bf343d30954135da8ad4ac"

# Install TEOS plugin
RUN git clone https://github.com/talaia-labs/rust-teos.git /tmp/teos_build && \
    cd /tmp/teos_build && \
    git checkout $TEOS_COMMIT

## Pinned Rust toolchain, so the plugin is not compiled by whatever is newest
ENV RUST_TOOLCHAIN="1.98.1"

WORKDIR /tmp/teos_build
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain "$RUST_TOOLCHAIN"

RUN echo "--- Installing TEOS Plugin ---"; \
    /root/.cargo/bin/cargo install --locked --path watchtower-plugin && \
    cp ~/.cargo/bin/watchtower-client /usr/local/bin/watchtower-client && \
    chmod +x /usr/local/bin/watchtower-client && \
    cd /root && \
    rm -rf /tmp/teos_build && \
    echo "--- TEOS Plugin installed successfully ---"

## Define xrebalance version - clboss v0.17+ runs its rebalancing through this
## external plugin (v0.4.5+ required; without it clboss warns hourly and no
## rebalancing happens). Rust, edition 2021: the pinned toolchain above builds it.
ENV XREBALANCE_COMMIT="bfe5dcf046dda1204a236a0494dfe6dcffce54ce"

# Install xrebalance plugin
RUN git clone https://github.com/ksedgwic/xrebalance.git /tmp/xrebalance_build && \
    cd /tmp/xrebalance_build && \
    git checkout $XREBALANCE_COMMIT

WORKDIR /tmp/xrebalance_build
RUN echo "--- Installing xrebalance Plugin ---" && \
    /root/.cargo/bin/cargo build --locked --release && \
    cp target/release/xrebalance /usr/local/bin/xrebalance && \
    chmod +x /usr/local/bin/xrebalance && \
    cd /root && \
    rm -rf /tmp/xrebalance_build && \
    echo "--- xrebalance Plugin installed successfully ---"

## Define clboss version - v0.17.x requires CLN >= v25.09 and treats v26.04+
## as its tested floor (it reads the getroutes fields v26.04/v26.06 provide;
## older CLN is refused at startup, which as an important-plugin stops
## lightningd). This commit is tag v0.17.1-rc1: chosen over v0.17.0 for its
## fund-safety fixes (no duplicate channel to an existing peer, no peer
## demerits during a Tor/network blackout). Move to v0.17.1 once it is tagged.
ENV CLBOSS_COMMIT="e65b4344995cc45e12c74ae020594ae519d061be"

# Install clboss plugin
RUN git clone https://github.com/ksedgwic/clboss.git /tmp/clboss_build && \
    cd /tmp/clboss_build && \
    git checkout $CLBOSS_COMMIT

WORKDIR /tmp/clboss_build
RUN echo "--- Installing Clboss Plugin ---" && \
    autoreconf -i && \
    ./configure

RUN echo "--- Compiling Clboss Plugin ---" && \
    make -j$(nproc) && \
    make install && \
    cd /root && \
    rm -rf /tmp/clboss_build && \
    echo "--- Clboss Plugin installed successfully ---"


# Copy plugins to the light base image
FROM elementsproject/lightningd:v26.06.8@sha256:56f1cebe829fbb3c7d5674be8cd1212c7e02527ab32403b695033a29bcd2abce AS final

# Runtime dependencies for plugins
RUN apt-get update && apt-get install -y \
    curl \
    dnsutils \
    libssl-dev \
    libev-dev \
    libffi-dev \
    libsqlite3-dev \
    libcurl4-gnutls-dev \
    libunwind-dev \
    python3-pip && \
    rm -rf /var/lib/apt/lists/*

# pyln-client: darknet.py imports it. The v25 base image shipped it; from
# v26.06 it does not, so it is installed here (pinned; pip pulls pyln-proto).
# The import check fails the build instead of shipping an image whose darknet
# plugin dies at startup (it is a plain plugin=, so lightningd would not stop).
RUN pip3 install --no-cache-dir --break-system-packages pyln-client==26.6.8 && \
    python3 -c 'import pyln.client'

# Copy plugins from builder stage
COPY --from=builder /usr/local/bin/clboss /usr/local/bin/clboss
COPY --from=builder /usr/local/bin/xrebalance /usr/local/bin/xrebalance
COPY --from=builder /usr/local/bin/watchtower-client /usr/local/bin/watchtower-client
COPY --from=builder /usr/local/bin/trustedcoin /usr/local/bin/trustedcoin
COPY --from=builder /usr/local/bin/peerswap /usr/local/bin/peerswap

# Copy custom plugin 'darknet' from the local directory
COPY darknet.py /usr/local/bin/darknet.py
RUN chmod +x /usr/local/bin/darknet.py

# Signal-forwarding entrypoint (the upstream one never passes SIGTERM on to
# lightningd, so every `docker stop` ended in SIGKILL). See the script header.
COPY lightningd-entrypoint.sh /usr/local/bin/lightningd-entrypoint.sh
RUN chmod +x /usr/local/bin/lightningd-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/lightningd-entrypoint.sh"]
