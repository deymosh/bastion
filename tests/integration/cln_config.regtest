# Test-only Core Lightning config for tests/integration/cln-onion-target.sh.
#
# The Tor block (proxy / addr=statictor / bind-addr / always-use-proxy) is
# identical in shape to stack-bitcoin/config/cln_config - that is the part
# under test. Only the chain backend differs: a throwaway regtest bitcoind via
# bcli, instead of mainnet trustedcoin, so the test needs no external network
# and finishes in seconds. bind-addr is the pinned bastion-transit-style
# address, which CLN must advertise to Tor as the onion forward target.

network=regtest

bitcoin-rpcuser=test
bitcoin-rpcpassword=test
bitcoin-rpcconnect=10.252.0.3
bitcoin-rpcport=18443

proxy=10.252.0.2:9050
addr=statictor:10.252.0.2:9051
always-use-proxy=true
bind-addr=10.252.0.10:9735

clnrest-port=3001
clnrest-host=0.0.0.0
log-level=info
