# Standalone Compose reference only. Bastion normally supplies these values from
# the root bastion.conf through stack-ai/.env.
#
# The three secrets below (CLAUDE_CODE_OAUTH_TOKEN, GITHUB_TOKEN,
# CCR_WEB_AUTH_TOKEN) are NOT read from here at runtime by Bastion: `./bastion`
# projects them into ../secrets/<name> and the compose files mount those as
# files under /run/secrets. Set them here only if you run this stack standalone
# with `docker compose` and no secrets/ directory - the containers fall back to
# the env var when the secret file is absent.

# CodeDeck+ Claude Code auth. CCR authenticates with an interactive `claude`
# login stored in data/ccr/.claude/.credentials.json.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...

# CCR management UI. Generate a long random value.
CCR_WEB_AUTH_TOKEN=

# 1 lets Claude Code populate its /model picker from the gateway's /v1/models.
# Ineffective if CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is set anywhere.
CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

# CCR OAuth token refresher (in-container). Defaults are usually fine.
#   CCR_TOKEN_REFRESH=1            # 0 disables the refresher
#   CCR_REFRESH_INTERVAL=300       # seconds between checks
#   CCR_REFRESH_SKEW_MS=1800000    # refresh this many ms before expiry

# Optional GitHub access used by CodeDeck's runtime credential helper.
GITHUB_TOKEN=

# Optional CodeDeck workspace settings.
GIT_REPO=
GIT_USER=
GIT_EMAIL=
CODEDECK_RELAYS=
CODEDECK_TOR_PROXY_URL=socks5h://tor:9050

# --- OpenCode (optional second session backend, CodeDeck+ >= v0.12.0) ---
# A bridge with none of these set behaves exactly as it always has - Claude
# Code only. See https://github.com/deymosh/codedeck-plus/blob/master/docs/OPENCODE.md
#
# Either point at an external `opencode serve` (wins over AUTO_START if both
# are set)...
# CODEDECK_OPENCODE_SERVER_URL=http://127.0.0.1:4096
#
# ...or have the bridge spawn and manage its own (binds 127.0.0.1 only inside
# the container - never exposed beyond it).
# CODEDECK_OPENCODE_AUTO_START=1
#
# Fixes the auto-started server's port instead of an OS-assigned one.
# CODEDECK_OPENCODE_PORT=4096

# --- GSD (github.com/open-gsd/gsd-core, optional planning workflow) ---
# Off by default: installing gsd-core is a plain npm-registry call the
# entrypoint would otherwise make on every container boot, unconditionally
# and outside CODEDECK_TOR_PROXY_URL. Set to 1 to have the container install
# it globally for Claude on startup. Leave unset/0/false to skip - a missing
# GSD install never blocks a normal session, it just leaves the phone's GSD
# stage strip empty.
# CODEDECK_GSD_AUTO_INSTALL=1

# --- MCP gateway (mcp-gateway, HTTP endpoint on :8811, see docs/mcp.md) ---

# Bearer token every remote MCP client must send to the gateway. Bastion
# projects this into ../secrets/mcp_gateway_token, mounted at
# /run/secrets/mcp_gateway_token - never a runtime env var. Generate a long
# random value; `./bastion` generates one automatically.
MCP_GATEWAY_TOKEN=

# Optional Context7 API key (context7.com/dashboard) for higher rate limits.
# Empty = keyless. Also delivered as a secret file, never an env var.
CONTEXT7_API_KEY=

# --- agent-docker (opt-in: ./bastion up --with-agent-docker, see docs/agent-docker.md) ---

# CPU / memory caps for the agent's private Docker daemon and everything it
# builds or runs, so builds never starve bitcoind / lightningd.
# AGENT_DOCKER_CPUS=2
# AGENT_DOCKER_MEMORY=4g
