# Standalone Compose reference only. Bastion normally supplies these values from
# the root bastion.conf through stack-ai/.env.

# Required by CodeDeck+ for Claude Code sessions. CCR uses provider credentials
# configured in its own UI instead of this token.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...

# Required by CCR's management UI. Generate a long random value.
CCR_WEB_AUTH_TOKEN=

# Optional GitHub access used by CodeDeck's runtime credential helper.
GITHUB_TOKEN=

# Optional CodeDeck workspace settings.
GIT_REPO=
GIT_USER=
GIT_EMAIL=
CODEDECK_RELAYS=
CODEDECK_TOR_PROXY_URL=socks5h://tor:9050