# Bastion Tor image.
#
# Tor from the Tor Project's own Debian repository (the maintained, officially
# recommended build) on a digest-pinned Debian stable. It replaces lncm/tor,
# which was unmaintained and stuck on Tor 0.4.7 (EOL) over Debian 11 (EOL).
#
# The contract the rest of Bastion relies on is unchanged:
#   - runs as toruser, uid/gid 1000, home /data;
#   - DataDirectory /data/.tor exists, owned 1000:1000, mode 0750, so the
#     bastion-tor-data volume seeds with that ownership on first mount and the
#     group-readable control cookie is usable by CLN and TEOS (which mount the
#     volume read-only as gid-1000 readers);
#   - `tor` reads the bind-mounted /etc/tor/torrc;
#   - bash + timeout exist for the compose healthcheck.
#
# To bump Tor: set TOR_VERSION to the version in
# https://deb.torproject.org/torproject.org/dists/<codename>/main/binary-amd64/Packages
# (the repo keeps only the current release, so a stale pin fails the build
# loudly rather than silently installing something else).
FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

ARG TOR_VERSION=0.4.9.13-1~d13.trixie+1
# Tor Project archive signing key, as published on
# https://support.torproject.org/apt/tor-deb-repo/ - the downloaded key is
# only trusted if its fingerprint matches this.
ARG TOR_KEY_FPR=A3C4F0F979CAA22CDBA8F512EE8CBC9E886DDD89

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gpg; \
    curl -fsSL "https://deb.torproject.org/torproject.org/${TOR_KEY_FPR}.asc" -o /tmp/tor.asc; \
    gpg --show-keys --with-colons /tmp/tor.asc | awk -F: '$1=="fpr"{print $10; exit}' | grep -qx "$TOR_KEY_FPR"; \
    gpg --dearmor < /tmp/tor.asc > /usr/share/keyrings/tor-archive-keyring.gpg; \
    echo "deb [signed-by=/usr/share/keyrings/tor-archive-keyring.gpg] https://deb.torproject.org/torproject.org trixie main" \
        > /etc/apt/sources.list.d/tor.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends "tor=${TOR_VERSION}"; \
    apt-get purge -y --auto-remove curl gpg; \
    rm -rf /var/lib/apt/lists/* /tmp/tor.asc

RUN groupadd -g 1000 toruser \
    && useradd -u 1000 -g 1000 -d /data -s /usr/sbin/nologin toruser \
    && mkdir -p /data/.tor \
    && chown 1000:1000 /data/.tor \
    && chmod 0750 /data/.tor

USER toruser
ENTRYPOINT ["tor", "-f", "/etc/tor/torrc"]
